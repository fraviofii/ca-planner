# Banco SQLite. Caminho relativo é resolvido a partir da pasta prisma/,
# por isso o ../ — o arquivo fica em <projeto>/data/ca_planner.db.
DATABASE_URL="file:../data/ca_planner.db"

# Credenciais da Pluggy: cadastre pela tela Conexões › Credenciais da Pluggy. Ficam no
# banco, com o secret cifrado (chave em data/.secret-key). As variáveis abaixo são só
# retaguarda opcional — se preenchidas, valem quando não houver credenciais no banco.
# PLUGGY_CLIENT_ID=""
# PLUGGY_CLIENT_SECRET=""

# Opcional: onde fica a chave que cifra os segredos (padrão: ao lado do banco)
# CA_PLANNER_KEY_FILE="/caminho/para/.secret-key"

# Opcional: outra URL base da API
# PLUGGY_BASE_URL="https://api.pluggy.ai"
